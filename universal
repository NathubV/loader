		end

		copying = true

		local copied = false

		local clipboardFunction = setclipboard

		if type(clipboardFunction) == "function" then

			local success = pcall(function()
				clipboardFunction(SCRIPT_TO_COPY)
			end)

			if success then
				copied = true
			end
		end

		if copied then

			copyButton.Text = "COPIED!"
			copyButton.TextColor3 = GREEN

		else

			local success = pcall(function()
				linkBox:CaptureFocus()
				linkBox.SelectionStart = 1
				linkBox.CursorPosition =
					#SCRIPT_TO_COPY + 1
			end)

			if success then
				copyButton.Text = "SELECTED"
				copyButton.TextColor3 = GREEN
			else
				copyButton.Text = "COPY UNAVAILABLE"
				copyButton.TextColor3 = RED
			end
		end

		task.delay(1.5, function()

			if copyButton.Parent then

