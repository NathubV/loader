	local function closeTeleportPanel()

		if closing then
			return
		end

		if not panel.Parent then
			return
		end

		closing = true
		teleportBusy = true

		closePanel.Active = false
		back.Active = false

		local slideOut = TweenService:Create(
			panel,
			TweenInfo.new(
				ANIMATION_TIME,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.InOut
			),
			{
				Position = UDim2.new(
					1,
					650,
					0.5,
					0
				)
			}
		)

		local restoreMain = TweenService:Create(
			main,
			TweenInfo.new(
				ANIMATION_TIME,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.InOut
			),
			{
				Size = NORMAL_SIZE
			}
		)

		slideOut:Play()
		restoreMain:Play()

		slideOut.Completed:Wait()

		if panel.Parent then
			panel:Destroy()
		end

		teleportPanel = nil
		teleportBusy = false
	end

	closePanel.MouseButton1Click:Connect(
		closeTeleportPanel
	)

	back.MouseButton1Click:Connect(
		closeTeleportPanel
	)

